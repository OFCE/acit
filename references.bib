@article{ippbach2025,
  journal={RFBerlin Discussion Paper Series},
  institution={Rockwool Foundation Berlin (RF Berlin)},
  author={Laurent Bach and Antoine Bozio and Arthur Guillouzouic and Clément Malgouyres},
  title={Do Billionaires Pay Taxes?},
  year={2025},
  month={Sep},
  number={2570},
  abstract={We link French households' tax records to the corporations they control, and build a payout-policy-neutral income measure, with corresponding tax burdens including those of \&quot;billionaires\&quot;: the top 0.0002\%. Defined as such, income is more concentrated than taxable income, it better predicts rich-list membership, and persists more among billionaires. Personal taxes remain progressive until the top 0.1\%, but eventually decline to 2\% of income. Corporate taxes are an imperfect progressive backstop, as total tax rates fall from 45\% at the 0.1\% threshold to 25\% for billionaires. Among these, the tax burden is global and tax-efficient pyramidal control over businesses is ubiquitous.},
  keywords={Income distribution; Tax progressivity; Business Income; Corporate tax},
  url={https://ideas.repec.org/p/crm/wpaper/2570.html},
}

